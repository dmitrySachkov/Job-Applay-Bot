# Скопируй этот файл в .env и заполни своими значениями.
# .env добавь в .gitignore — туда попадает путь к секретному ключу.

# Путь к JSON-ключу сервис-аккаунта Google Cloud
GOOGLE_SHEETS_CREDS=/Users/dmitrysachkov/job-apply-bot/service-account.json

# ID таблицы — кусок URL между /d/ и /edit
GOOGLE_SHEET_ID=

# Название вкладки в таблице (необязательно, по умолчанию "Applications")
GOOGLE_SHEET_TAB=Applications
